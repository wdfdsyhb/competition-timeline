gName": "‌LLM"}], "name": "2026 SMP第十四届全国社会媒体处理大会-大模型图网络决策挑战赛", "currency": 0, "introduction": "第十四届全国社会媒体处理大会（SMP 2026）将于2026年11月12日至15日在北京召开。本届大会的主题是“大模型驱动人机共生”，旨在探索在大模型和智能体快速发展给人类社会带来的颠覆性变化以及构建人机和谐共生的社会新生态的路径。\nSMP 2026挑战赛由中国中文信息学会社会媒体处理专委会主办，天池平台为指定赛事平台。本次比赛以外星文明降临地球的科幻故事为背景，邀请广大开发者和相关技术团队，通过科学的算法与策略设计，探索解决网络演化预测与有效干预等核心难题。"}, {"raceId": 532512, "referUrl": "", "raceListStatus": 0, "raceStartTime": "2026-08-20 00:00:00", "bonus": 0, "highlightEn": "", "teamCount": 504, "orgUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532512/1242990779776242/mpf88jwki1wxqu98.png;https://static.tianchi.aliyun.com/tianchi/race/images/prod/532512/1242990779776242/ct6vf7dcyk6ekm26.png", "isSeries": 0, "coverUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532512/1242990779776242/o2vx2u7412gma59y.png", "highlight": "证书+评测论文", "signupEndTime": "2029-10-03 23:59:59", "raceEndTime": "2029-10-03 23:59:59", "signupStartTime": "2026-10-03 00:00:00", "visualTab": 1, "tagsList": [{"tagId": 132, "tagType": "RACE", "tagNameCn": "‌医疗健康", "tagName": "Medical Health"}, {"tagId": 151, "tagType": "RACE", "tagNameCn": "自然语言处理", "tagName": "NLP"}, {"tagId": 149, "tagType": "RACE", "tagNameCn": "大语言模型", "tagName": "‌LLM"}], "name": "CHIP2026-面向生物医学全文的特定患者表型概念识别任务", "currency": 0, "introduction": "第十二届中国健康信息处理大会（CHIP 2026）评测"}, {"raceId": 532510, "referUrl": "", "raceListStatus": 0, "raceStartTime": "2026-08-07 00:00:00", "bonus": 20000, "highlightEn": "", "teamCount": 1535, "orgUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532510/WB02138154/ii3xu35t8oa3rrzp.png", "isSeries": 0, "coverUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532510/WB02138154/mrdygxrul3ypaahs.jpg", "highlight": "", "signupEndTime": "2026-12-31 23:59:59", "raceEndTime": "2026-12-31 23:59:59", "signupStartTime": "2026-10-01 00:00:00", "visualTab": 1, "tagsList": [{"tagId": 151, "tagType": "RACE", "tagNameCn": "自然语言处理", "tagName": "NLP"}, {"tagId": 149, "tagType": "RACE", "tagNameCn": "大语言模型", "tagName": "‌LLM"}], "name": "知乎知学堂大模型挑战赛：大模型复杂表格识别与内容理解", "currency": 0, "introduction": "本赛题面向图片和 PDF 文件中的复杂表格识别与内容理解。参赛者需要读取\n题目清单，识别目标文档中的表格结构和表格内容，并完成结构恢复、内容提取\n或简单推理计算，最终提交可自动评分的 Excel 结果文件。"}, {"raceId": 41, "referUrl": "", "raceStartTime": "2026-08-06 00:00:00", "bonus": 300000, "highlightEn": "", "teamCount": 697, "nameEn": "2026具身世界realworld挑战赛", "orgUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/41/WB02138154/epvz4dadm5vc77ad.png", "isSeries": 1, "coverUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/41/WB02138154/zfq3mmb47jftu8r2.png", "highlight": "", "raceEndTime": "2026-11-30 23:59:59", "trackList": [{"raceId": 532506, "referUrl": "", "raceListStatus": 2, "raceStartTime": "2026-07-30 00:00:00", "bonus": 100000, "highlightEn": "", "teamCount": 254, "nameEn": "", "orgUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532506/WB02138154/j8smcm3n4p5w8yhn.png", "isSeries": 0, "coverUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532506/WB02138154/ufqobc3mi4hf7elq.png", "highlight": "", "raceEndTime": "2026-11-15 23:59:59", "visualTab": 1, "tagsList": [], "name": "2026-具身仿真合成挑战赛", "currency": 0, "introduction": "仿真资产是具身智能发展的重要基础，广泛应用于仿真场景构建、机器人训练以及仿真到现实的部署验证。本次比赛是全球首个聚焦多设备真实视频到可交互仿真资产端到端生成与系统评测的具身仿真合成挑战赛。参赛队伍需基于多设备采集的真实物体视频，构建自动化处理流水线，生成结构准确、外观真实、物理可信且可交互的高质量仿真就绪型资产。"}, {"raceId": 532507, "referUrl": "", "raceListStatus": 2, "raceStartTime": "2026-07-30 00:00:00", "bonus": 100000, "highlightEn": "", "teamCount": 204, "nameEn": "", "orgUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532507/WB02138154/8cu44x5somre217q.png", "isSeries": 0, "coverUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532507/WB02138154/x7grgmzn4dq04cqg.png", "highlight": "", "raceEndTime": "2026-11-15 23:59:59", "visualTab": 1, "tagsList": [], "name": "2026-具身安全应用挑战赛", "currency": 0, "introduction": "围绕“感知—决策—执行”完整闭环，设置视觉感知、空间感知、任务决策、控制通信、状态估计、执行反馈六个攻击环节，考察具身智能模型在遭受多域攻击时的异常发现、链路识别、危险阻断、降级处置与任务恢复等能力。本次比赛是全球首个以具身安全为核心命题，特别支持VLA、WAM等多模态融合技术的具身安全应用挑战赛，旨在检验多模态感知与决策系统在复杂攻击下的鲁棒性。每类赛题包含简单、中等和困难等难度，正式评测中的攻击形式与参数不公开，重点考察具身模型面对未知异常的泛化防御能力。"}, {"raceId": 532508, "referUrl": "", "raceListStatus": 2, "raceStartTime": "2026-07-30 00:00:00", "bonus": 100000, "highlightEn": "", "teamCount": 239, "nameEn": "", "orgUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532508/WB02138154/6xluv3vhf3qecgii.png", "isSeries": 0, "coverUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532508/WB02138154/7n494mw4j8z1bry0.png", "highlight": "", "raceEndTime": "2026-11-15 23:59:59", "visualTab": 1, "tagsList": [{"tagId": 177, "tagType": "RACE", "tagNameCn": "机器人", "tagName": "机器人"}], "name": "2026-跨本体具身认知极限联合挑战赛", "currency": 0, "introduction": "本赛道聚焦具身智能从仿真训练走向多型号真机验证，探索机器人策略在不同本体和真实物理环境中的迁移能力。本次赛事是全球首个跨本体、跨平台、跨场景仿真+真机挑战赛。"}], "visualTab": 1, "tagsList": [{"tagId": 177, "tagType": "RACE", "tagNameCn": "机器人", "tagName": "机器人"}], "name": "2026-具身极限挑战赛", "currency": 0, "introduction": "随着具身智能加速走出实验室、进入真实产业场景，衡量机器人能力的标准正在发生根本变化：真正决定其能否规模化落地的，不再只是完成一项预设任务，而是能否理解真实世界、适应不同身体，并在复杂风险中保持安全与可靠。\n\n"}, {"raceId": 38, "referUrl": "https://tianchi.aliyun.com/competition/entrance/532495", "raceStartTime": "2026-07-17 00:00:00", "bonus": 200000, "highlightEn": "", "teamCount": 1689, "nameEn": "欧莱雅集团第二届美妆科技黑客松 - 用 AI 造点美", "orgUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/38/WB02138154/9k83w0dhmh9mlstn.png", "isSeries": 1, "coverUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/38/WB02138154/xb6k7d83rqqt2x0k.jpg", "highlight": "", "raceEndTime": "2026-10-27 23:59:59", "trackList": [{"raceId": 532503, "referUrl": "", "raceListStatus": 4, "raceStartTime": "2026-07-17 00:00:00", "bonus": 200000, "highlightEn": "", "teamCount": 733, "nameEn": "", "orgUrl": "https://static.tianchi.aliyun.com/tianchi/race/images/prod/532503/WB02138154/o42wfyvosc2jeim7.png", "isSeries": 0, "coverUrl": "https://sta